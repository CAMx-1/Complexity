{
  "manifest": {
    "publishingInformation": {
      "locales": {
        "en-US": {
          "name": "Complexity",
          "summary": "Watch your Plex library on Echo Show.",
          "description": "Complexity plays movies and TV from your own Plex Media Server on Echo Show devices. Link your Plex account with a short code at plex.tv/link; no password is ever shared with the skill. Not affiliated with Plex, Inc.",
          "examplePhrases": [
            "Alexa, open complexity",
            "Alexa, ask complexity which server am I using",
            "Alexa, ask complexity to switch server"
          ],
          "keywords": [
            "plex",
            "video",
            "movies",
            "tv"
          ]
        }
      },
      "isAvailableWorldwide": false,
      "distributionCountries": [
        "US"
      ],
      "testingInstructions": "Requires a Plex account with a Plex Media Server that has Remote Access enabled.",
      "category": "STREAMING_SERVICE"
    },
    "apis": {
      "custom": {
        "interfaces": [
          {
            "type": "ALEXA_PRESENTATION_APL",
            "supportedViewports": [
              {
                "mode": "HUB",
                "shape": "RECTANGLE",
                "minWidth": 960,
                "maxWidth": 2560,
                "minHeight": 480,
                "maxHeight": 1600
              }
            ]
          }
        ],
        "endpoint": {
          "uri": "arn:aws:lambda:us-east-1:156876768471:function:9dd8cd52-c96b-421f-9c05-d33f7985e033:Release_0"
        },
        "regions": {
          "EU": {
            "endpoint": {
              "uri": "arn:aws:lambda:eu-west-1:156876768471:function:9dd8cd52-c96b-421f-9c05-d33f7985e033:Release_0"
            }
          },
          "NA": {
            "endpoint": {
              "uri": "arn:aws:lambda:us-east-1:156876768471:function:9dd8cd52-c96b-421f-9c05-d33f7985e033:Release_0"
            }
          },
          "FE": {
            "endpoint": {
              "uri": "arn:aws:lambda:us-west-2:156876768471:function:9dd8cd52-c96b-421f-9c05-d33f7985e033:Release_0"
            }
          }
        }
      }
    },
    "privacyAndCompliance": {
      "allowsPurchases": false,
      "usesPersonalInfo": false,
      "isChildDirected": false,
      "isExportCompliant": true,
      "containsAds": false,
      "locales": {
        "en-US": {}
      }
    },
    "events": {
      "endpoint": {
        "uri": "arn:aws:lambda:us-east-1:156876768471:function:9dd8cd52-c96b-421f-9c05-d33f7985e033:Release_0"
      },
      "subscriptions": [
        {
          "eventName": "SKILL_DISABLED"
        }
      ]
    },
    "manifestVersion": "1.0"
  }
}
